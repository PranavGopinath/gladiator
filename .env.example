# --- API credentials ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set AGENT=codex and supply a key to run the installed Codex CLI.
CODEX_API_KEY=

# Host-side live outcome forecasts; never passed to contestants.
JEV_KEY=
JEV_MODEL=jev-latest
# Evaluation interval in seconds (2–60); default 5.
JEV_INTERVAL_SECONDS=5
# Set to 0 to run matches without Jev requests.
JEV_ENABLED=1

# --- Model selection ---
# Explicit model IDs; change these to models enabled on your API accounts.
CODEX_MODEL=gpt-5.5
CLAUDE_MODEL=claude-opus-4-8
MODEL=

# --- Python arena (dashboard.py, supervisor.py) ---
AGENT=demo
# AGENT=custom runs this argv (parsed with shlex; no implicit shell).
AGENT_COMMAND=
TASK=
# compose.override.yaml runs the authenticated pair by default.
CODEX_TASK=
CLAUDE_TASK=
# 0.0.0.0 permits inbound access through all host interfaces.
BIND_ADDRESS=127.0.0.1

# --- TypeScript coordinator (src/) ---
PORT=3000

# --- Betting market / Stripe credits (host-side only; never sent to containers) ---
# Sandbox (test) keys from the Stripe Dashboard. Leave blank to disable purchases.
STRIPE_SECRET_KEY=
# Printed by `stripe listen` (whsec_...); required to accept webhooks.
STRIPE_WEBHOOK_SECRET=
# Optional pari-mutuel rake in basis points (0 = none; 500 = 5%).
ARENA_RAKE_BPS=0
# Set to 1 ONLY with no Stripe key, to allow unsigned local test top-ups.
ARENA_DEV_CREDITS=0

# Host-only strategy learning. Apply the SQL files in supabase/migrations/ in filename order.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
